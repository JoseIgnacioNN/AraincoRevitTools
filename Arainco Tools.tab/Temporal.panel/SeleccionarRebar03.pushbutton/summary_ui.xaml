<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arainco — Selección de Rebars: Resumen"
        SizeToContent="Height" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#071018"
        Foreground="#C8E4EF"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5DB9EA"/>
            <Setter Property="Foreground" Value="#071018"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="24,7"/>
            <Setter Property="BorderBrush" Value="#87D9EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#74CEE8"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#A5E6F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#49B1D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilos para ScrollBar Arainco -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#1F435B" CornerRadius="4" BorderBrush="#2B5A78" BorderThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#08131E"/>
            <Setter Property="BorderBrush" Value="#142E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#071018" BorderBrush="#21465C" BorderThickness="1" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Encabezado Corporativo ARAINCO -->
            <Border Grid.Row="0"
                    Background="#0F2535"
                    BorderBrush="#21465C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Isotipo Vectorial Arainco Oficial -->
                    <Border Grid.Column="0"
                            Background="#071018"
                            BorderBrush="#21465C"
                            BorderThickness="1"
                            CornerRadius="6"
                            Width="40" Height="40"
                            Margin="0,0,12,0">
                        <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="100" Height="75">
                                <Path Fill="#5DB9EA" Data="M 2.6,71.2 L 38.6,8.8 Q 46.4,3.5 53.9,3.8 Q 58.4,5.0 61.1,8.6 L 25.4,70.9 Z"/>
                                <Path Fill="#1F435B" Data="M 62.9,11.2 L 52.7,29.2 L 58.4,41.0 L 81.2,43.4 Z"/>
                                <Path Fill="#1F435B" Data="M 66.8,57.1 L 74.0,71.2 L 97.1,71.2 L 84.5,49.4 Z"/>
                                <Path Fill="#B8B0AD" Data="M 82.7,46.6 L 59.3,44.2 L 40.1,52.0 L 29.9,69.4 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ARAINCO" FontSize="13.5" FontWeight="Bold" Foreground="#E8F4F8" Margin="0,0,6,0"/>
                            <TextBlock Text="INGENIERÍA ESTRUCTURAL" FontSize="13.5" FontWeight="SemiBold" Foreground="#5DB9EA"/>
                        </StackPanel>
                        <TextBlock Text="SELECCIÓN DE STRUCTURAL REBARS — REPORTE DE RESULTADOS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#95B8CC"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Tarjetas de Indicadores (KPIs) -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Analizados -->
                <Border Grid.Column="0"
                        Background="#0E1B32"
                        BorderBrush="#21465C"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="0,0,6,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="REBARS ANALIZADOS" FontSize="9.5" FontWeight="SemiBold" Foreground="#95B8CC" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lbl_kpi_total" Text="0" FontSize="22" FontWeight="Bold" Foreground="#E8F4F8" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBlock Text="En vista o selección" FontSize="9" Foreground="#64889E" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Seleccionados con Forma Objetivo -->
                <Border Grid.Column="1"
                        Background="#0E1B32"
                        BorderBrush="#5DB9EA"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="3,0,3,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="SELECCIONADOS" FontSize="9.5" FontWeight="SemiBold" Foreground="#5DB9EA" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lbl_kpi_seleccionados" Text="0" FontSize="22" FontWeight="Bold" Foreground="#4ECDC4" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBlock x:Name="lbl_kpi_shape_label" Text="Con Rebar Shape '03'" FontSize="9" Foreground="#64889E" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Otras Formas -->
                <Border Grid.Column="2"
                        Background="#0E1B32"
                        BorderBrush="#21465C"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="6,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="FORMAS DETECTADAS" FontSize="9.5" FontWeight="SemiBold" Foreground="#95B8CC" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lbl_kpi_formas" Text="0" FontSize="22" FontWeight="Bold" Foreground="#B8B0AD" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBlock Text="Variedades en vista" FontSize="9" Foreground="#64889E" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Panel de Detalles y Registro -->
            <Border Grid.Row="2"
                    Background="#0A1620"
                    BorderBrush="#21465C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="DETALLES DE LA OPERACIÓN Y ELEMENTOS SELECCIONADOS"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="#95B8CC"/>
                        <Border x:Name="bd_badge"
                                HorizontalAlignment="Right"
                                Background="#0E1B32"
                                BorderBrush="#4ECDC4"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,2">
                            <TextBlock x:Name="lbl_status_icon"
                                       Text="✓ Selección Activa en Revit"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#4ECDC4"/>
                        </Border>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="140">
                        <TextBlock x:Name="lbl_summary_details"
                                   Text="Detalles de ejecución..."
                                   FontSize="11.5"
                                   Foreground="#C8E4EF"
                                   TextWrapping="Wrap"
                                   LineHeight="17"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- 4. Pie de Ventana -->
            <Grid Grid.Row="3">
                <TextBlock Text="Los elementos indicados se encuentran actualmente seleccionados en la interfaz de Revit."
                           FontSize="10"
                           Foreground="#64889E"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                <Button x:Name="btn_cerrar"
                        Content="Cerrar"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right"
                        Click="on_cerrar_click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
