<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arainco — Seleccionar Structural Rebars (Forma 03)"
        SizeToContent="Height" Width="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#071018"
        Foreground="#C8E4EF"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5DB9EA"/>
            <Setter Property="Foreground" Value="#071018"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="BorderBrush" Value="#87D9EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#74CEE8"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#A5E6F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#49B1D0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#0A1620"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#1A3A4D"/>
                                <Setter Property="Foreground" Value="#64889E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0E1B32"/>
            <Setter Property="Foreground" Value="#E8F4F8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#21465C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#11253D"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#5DB9EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón Manual de Usuario (Paleta Corporativa Arainco) -->
        <Style x:Key="ManualButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#11253D"/>
            <Setter Property="Foreground" Value="#5DB9EA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2B5A78"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#183452"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#5DB9EA"/>
                                <Setter Property="Foreground" Value="#E8F4F8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0A1620"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#49B1D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== ESTILOS CORPORATIVOS ARAINCO PARA CHECKBOX Y RADIOBUTTON ==================== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C8E4EF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxBorder"
                                    Grid.Column="0"
                                    Width="16" Height="16"
                                    CornerRadius="3.5"
                                    Background="#050E18"
                                    BorderBrush="#2B5A78"
                                    BorderThickness="1.3"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 2.5,7.5 L 6,11 L 12.5,3.5"
                                      Stroke="#071018"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#5DB9EA"/>
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#0B1D30"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#5DB9EA"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#87D9EE"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#74CEE8"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#A5E6F5"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#071018"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#1A3A4D"/>
                                <Setter Property="Foreground" Value="#64889E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C8E4EF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="RadioBorder"
                                    Grid.Column="0"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    Background="#050E18"
                                    BorderBrush="#2B5A78"
                                    BorderThickness="1.3"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="RadioMark"
                                         Width="8" Height="8"
                                         Fill="#5DB9EA"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="#5DB9EA"/>
                                <Setter TargetName="RadioBorder" Property="Background" Value="#0B1D30"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioBorder" Property="Background" Value="#0E1B32"/>
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="#5DB9EA"/>
                                <Setter TargetName="RadioMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="#74CEE8"/>
                                <Setter TargetName="RadioMark" Property="Fill" Value="#74CEE8"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RadioBorder" Property="Background" Value="#071018"/>
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="#1A3A4D"/>
                                <Setter Property="Foreground" Value="#64889E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== ESTILOS CORPORATIVOS ARAINCO PARA SCROLLBAR ==================== -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="#1F435B"
                                BorderBrush="#2B5A78"
                                BorderThickness="1"
                                CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#5DB9EA"/>
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#87D9EE"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#49B1D0"/>
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#5DB9EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#08131E"/>
            <Setter Property="BorderBrush" Value="#142E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== ESTILOS CORPORATIVOS ARAINCO PARA COMBOBOX ==================== -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border"
                        Grid.ColumnSpan="2"
                        Background="#050E18"
                        BorderBrush="#1A3A4D"
                        BorderThickness="1"
                        CornerRadius="4"/>
                <Border x:Name="ArrowZone"
                        Grid.Column="1"
                        Background="#0A1826"
                        BorderBrush="#1A3A4D"
                        BorderThickness="1,0,0,0"
                        CornerRadius="0,4,4,0"
                        Margin="0,1,1,1"/>
                <Path x:Name="Arrow"
                      Grid.Column="1"
                      Fill="#5DB9EA"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0,0 L 4.5,5 L 9,0 Z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#5DB9EA"/>
                    <Setter TargetName="Border" Property="Background" Value="#081523"/>
                    <Setter TargetName="ArrowZone" Property="Background" Value="#11253D"/>
                    <Setter TargetName="ArrowZone" Property="BorderBrush" Value="#5DB9EA"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#74CEE8"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#5DB9EA"/>
                    <Setter TargetName="ArrowZone" Property="Background" Value="#11253D"/>
                    <Setter TargetName="ArrowZone" Property="BorderBrush" Value="#5DB9EA"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="#0A1620"/>
            <Setter Property="Foreground" Value="#C8E4EF"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#11253D"/>
                                <Setter Property="Foreground" Value="#5DB9EA"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#11253D"/>
                                <Setter Property="Foreground" Value="#5DB9EA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0E1B32"/>
                                <Setter Property="Foreground" Value="#4ECDC4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E8F4F8"/>
            <Setter Property="Background" Value="#050E18"/>
            <Setter Property="BorderBrush" Value="#1A3A4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxDropDownHeight" Value="240"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggleButton}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,3,32,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#0A1620"
                                            BorderBrush="#5DB9EA"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="2"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}"/>
    </Window.Resources>

    <Border Background="#071018" BorderBrush="#21465C" BorderThickness="1" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Encabezado Corporativo ARAINCO -->
            <Border Grid.Row="0"
                    Background="#0F2535"
                    BorderBrush="#21465C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Isotipo Vectorial Arainco Oficial -->
                    <Border Grid.Column="0"
                            Background="#071018"
                            BorderBrush="#21465C"
                            BorderThickness="1"
                            CornerRadius="6"
                            Width="42" Height="42"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <Viewbox Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="100" Height="75">
                                <Path Fill="#5DB9EA" Data="M 2.6,71.2 L 38.6,8.8 Q 46.4,3.5 53.9,3.8 Q 58.4,5.0 61.1,8.6 L 25.4,70.9 Z"/>
                                <Path Fill="#1F435B" Data="M 62.9,11.2 L 52.7,29.2 L 58.4,41.0 L 81.2,43.4 Z"/>
                                <Path Fill="#1F435B" Data="M 66.8,57.1 L 74.0,71.2 L 97.1,71.2 L 84.5,49.4 Z"/>
                                <Path Fill="#B8B0AD" Data="M 82.7,46.6 L 59.3,44.2 L 40.1,52.0 L 29.9,69.4 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Seleccionar Rebars (Forma 03)" FontSize="16" FontWeight="Bold" Foreground="#E8F4F8"/>
                        <TextBlock Text="Filtro analítico de Structural Rebars por Rebar Shape" FontSize="11" Foreground="#95B8CC" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="ARAINCO" FontSize="11.5" FontWeight="Bold" Foreground="#E8F4F8" HorizontalAlignment="Right"/>
                        <TextBlock Text="INGENIERÍA ESTRUCTURAL" FontSize="7.5" FontWeight="SemiBold" Foreground="#5DB9EA" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Información de la Vista Activa & Mini KPIs -->
            <Border Grid.Row="1"
                    Background="#0A1620"
                    BorderBrush="#21465C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Info Vista -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="VISTA ACTIVA" FontSize="9" FontWeight="Bold" Foreground="#5DB9EA"/>
                            <TextBlock x:Name="lbl_vista_nombre" Text="Cargando..." FontSize="13" FontWeight="SemiBold" Foreground="#E8F4F8" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="ESCALA / TIPO" FontSize="9" FontWeight="Bold" Foreground="#95B8CC" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="lbl_vista_escala" Text="1:50" FontSize="11.5" Foreground="#C8E4EF" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Mini Tarjetas KPI en Vista -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#0E1B32" BorderBrush="#21465C" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,4,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="TOTAL REBARS" FontSize="8.5" FontWeight="SemiBold" Foreground="#95B8CC" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="lbl_kpi_vista_total" Text="0" FontSize="16" FontWeight="Bold" Foreground="#E8F4F8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#0E1B32" BorderBrush="#5DB9EA" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="2,0,2,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="FORMA OBJETIVO" FontSize="8.5" FontWeight="SemiBold" Foreground="#5DB9EA" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="lbl_kpi_vista_forma03" Text="0" FontSize="16" FontWeight="Bold" Foreground="#4ECDC4" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#0E1B32" BorderBrush="#21465C" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="4,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="FORMAS DISTINTAS" FontSize="8.5" FontWeight="SemiBold" Foreground="#95B8CC" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="lbl_kpi_vista_formas_count" Text="0" FontSize="16" FontWeight="Bold" Foreground="#B8B0AD" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. Ámbito de Búsqueda -->
            <Border Grid.Row="2"
                    Background="#0A1620"
                    BorderBrush="#21465C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ÁMBITO DE LA SELECCIÓN" FontSize="10" FontWeight="Bold" Foreground="#95B8CC" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="rb_ambito_vista"
                                     Grid.Column="0"
                                     Content="Toda la vista activa"
                                     IsChecked="True"
                                     Checked="on_ambito_changed"/>
                        <RadioButton x:Name="rb_ambito_seleccion"
                                     Grid.Column="1"
                                     Content="Solo dentro de selección previa"
                                     IsEnabled="False"
                                     Checked="on_ambito_changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Filtro por Rebar Shape -->
            <Border Grid.Row="3"
                    Background="#0A1620"
                    BorderBrush="#21465C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="CRITERIO DE FORMA (REBAR SHAPE)" FontSize="10" FontWeight="Bold" Foreground="#95B8CC"/>
                        <TextBlock Text="Nombre o código de forma" FontSize="9.5" Foreground="#64889E" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Input de Texto y Selector de Formas Detectadas -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Input directo del código -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nombre / Código:" FontSize="10" Foreground="#C8E4EF" Margin="0,0,0,4"/>
                            <TextBox x:Name="txt_shape_filter"
                                     Text="03"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0"
                                     Background="#050E18"
                                     Foreground="#5DB9EA"
                                     FontWeight="Bold"
                                     FontSize="13"
                                     CaretBrush="#5DB9EA"
                                     BorderThickness="1"
                                     BorderBrush="#2B5A78"
                                     TextChanged="on_filter_changed"/>
                        </StackPanel>

                        <!-- Desplegable con formas detectadas -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Formas detectadas en la vista:" FontSize="10" Foreground="#C8E4EF" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cb_shapes_disponibles"
                                      Height="32"
                                      SelectionChanged="on_shape_selected"/>
                        </StackPanel>
                    </Grid>

                    <!-- Opciones de Coincidencia -->
                    <TextBlock Text="Tipo de coincidencia:" FontSize="10" Foreground="#95B8CC" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="rb_match_contains"
                                     Grid.Column="0"
                                     Content="Contiene el texto (ej. '03', 'M_03')"
                                     IsChecked="True"
                                     Checked="on_filter_changed"/>
                        <RadioButton x:Name="rb_match_exact"
                                     Grid.Column="1"
                                     Content="Coincidencia exacta (solo '03')"
                                     Checked="on_filter_changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. Opciones Complementarias de Vista -->
            <Border Grid.Row="4"
                    Background="#0A1620"
                    BorderBrush="#21465C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="ACCIONES EN LA VISTA" FontSize="10" FontWeight="Bold" Foreground="#95B8CC" Margin="0,0,0,8"/>
                    <CheckBox x:Name="chk_aislar_vista"
                              Content="Aislar temporalmente elementos en la vista (Temporary Isolate)"
                              IsChecked="False"
                              Margin="0,0,0,6"/>
                    <CheckBox x:Name="chk_zoom_seleccion"
                              Content="Ajustar encuadre de vista a la selección (Zoom to Fit)"
                              IsChecked="True"/>
                </StackPanel>
            </Border>

            <!-- 6. Panel de Barra de Progreso de Ejecución -->
            <Border x:Name="bd_progress"
                    Grid.Row="5"
                    Background="#0F2535"
                    BorderBrush="#21465C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,12"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lbl_progress_status"
                                   Grid.Column="0"
                                   Text="Filtrando armaduras..."
                                   FontSize="11.5"
                                   Foreground="#E8F4F8"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="lbl_progress_percent"
                                   Grid.Column="1"
                                   Text="0%"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#5DB9EA"
                                   Margin="12,0,0,0"/>
                    </Grid>
                    <ProgressBar x:Name="pb_ejecucion"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="#050E18"
                                 Foreground="#5DB9EA"
                                 BorderBrush="#1A3A4D"
                                 BorderThickness="1"/>
                </StackPanel>
            </Border>

            <!-- 7. Pie de Ventana / Botones de Acción -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btn_manual"
                        Grid.Column="0"
                        Content="Manual"
                        Width="90" Height="34"
                        ToolTip="Abrir manual de usuario"
                        Style="{StaticResource ManualButtonStyle}"
                        Click="on_manual_click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_cancelar"
                            Content="Cancelar"
                            Width="95" Height="34"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="on_cancelar_click"/>
                    <Button x:Name="btn_ejecutar"
                            Content="Seleccionar en Revit"
                            Width="160" Height="34"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="on_ejecutar_click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
